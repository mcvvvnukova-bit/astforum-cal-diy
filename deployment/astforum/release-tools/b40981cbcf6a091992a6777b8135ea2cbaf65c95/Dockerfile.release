FROM astforum/cal-diy:a1a976c5e3fc AS builder
WORKDIR /calcom
COPY overlay/ ./
ARG BUILD_DATABASE_URL
RUN DATABASE_URL="$BUILD_DATABASE_URL" DATABASE_DIRECT_URL="$BUILD_DATABASE_URL" \
    NEXTAUTH_SECRET=astforum-disposable-build-only-secret \
    CALENDSO_ENCRYPTION_KEY=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa \
    NEXTAUTH_URL=https://cal.astforum.ru/api/auth NEXT_PUBLIC_WEBAPP_URL=https://cal.astforum.ru \
    CALCOM_TELEMETRY_DISABLED=1 NEXT_TELEMETRY_DISABLED=1 TURBO_TELEMETRY_DISABLED=1 \
    BUILD_STANDALONE=true NODE_OPTIONS=--max-old-space-size=4096 \
    yarn workspace @calcom/web build

FROM astforum/cal-diy:a1a976c5e3fc
COPY --from=builder /calcom/apps/web /calcom/apps/web
ARG VCS_REF
LABEL org.opencontainers.image.revision=$VCS_REF \
      org.opencontainers.image.base.name="astforum/cal-diy:a1a976c5e3fc" \
      org.opencontainers.image.base.digest="sha256:ae6994656ae304cff864c4e4c92ba1067da44e6617dfa2b0e483d654314354d3"
CMD ["yarn", "start"]
